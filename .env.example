# ===== CONFIGURACIÓN DEL BOT =====

# DISCORD WEBHOOK URL
# Obtén esto de: Servidor Discord → Canal → Integrations → Webhooks → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE

# TELEGRAM BOT (opcional - si lo implementas después)
# TELEGRAM_BOT_TOKEN=your_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# LOG LEVEL
LOG_LEVEL=INFO

# SCAN INTERVAL (segundos)
SCAN_INTERVAL=300

# ===== NOTAS =====
# 1. Copia este archivo a .env
# 2. Reemplaza YOUR_WEBHOOK_URL_HERE con tu webhook real
# 3. No compartas este archivo (contiene tu webhook)
# 4. Agregalo a .gitignore
